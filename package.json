{
  "name": "@axols/webai-js",
  "version": "2.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Run v4 browser AI model workers locally through one JavaScript API, with manifest-driven inputs, downloads, benchmarks, and lifecycle management.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axolsai/webai-js.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./workers/*": "./model-workers-v4/*.worker.js"
  },
  "files": [
    "dist",
    "model-workers-v4/*.worker.js",
    "docs/WORKER_CONTRACT.md",
    "docs/ADDING_MODELS.md",
    "docs/worker-template.js",
    "benchmarks/*.json",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://www.webai-js.com",
  "keywords": [
    "Web AI",
    "Local AI",
    "Transformers JS",
    "AI in the Browser",
    "WebGPU"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "author": "Axols WebAI",
  "license": "Apache-2.0",
  "type": "commonjs",
  "dependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.66"
  }
}
